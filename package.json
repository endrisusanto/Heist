{
  "name": "heist-monorepo",
  "version": "0.2.1",
  "private": true,
  "description": "Heist - Centralized Android Test Automation Hub & System Tray Fleet Bridge",
  "workspaces": [
    "web-hub/server",
    "web-hub/client"
  ],
  "scripts": {
    "dev:hub": "npm run dev --workspace=web-hub/server",
    "dev:client": "npm run dev --workspace=web-hub/client",
    "build:hub": "npm run build --workspace=web-hub/server",
    "build:client": "npm run build --workspace=web-hub/client",
    "build": "npm run build:client && npm run build:hub",
    "start": "node web-hub/server/dist/index.js"
  }
}
